# Optional explicit font for FFmpeg watermark rendering (recommended on Windows)
FFMPEG_FONT_FILE=C:/Windows/Fonts/arial.ttf
# Default dynamic renderer. Set to ffmpeg only when diagnosing Remotion issues.
RENDER_ENGINE=remotion
# When Remotion fails, automatically complete the same job with the existing FFmpeg renderer.
REMOTION_FALLBACK_TO_FFMPEG=true
# Optional browser path. Windows automatically detects the standard Google Chrome location.
REMOTION_BROWSER_EXECUTABLE=C:/Program Files/Google/Chrome/Application/chrome.exe
NODE_ENV=development
APP_URL=http://localhost:3000

DATABASE_URL=file:./storage/stickmotion.db
LOCAL_STORAGE_DIR=storage/media

OPENAI_API_KEY=
OPENAI_SCRIPT_MODEL=gpt-5.6-terra
OPENAI_TTS_MODEL=tts-1
OPENAI_TRANSCRIBE_MODEL=gpt-4o-transcribe

IMAGE_API_KEY=
IMAGE_API_BASE_URL=https://www.hfsyapi.cn
IMAGE_API_MODEL=gpt-image-2
IMAGE_API_SIZE=1K

VOXCPM_HOME=D:/AI-Tools/VoxCPM
VOXCPM_PYTHON=D:/AI-Tools/VoxCPM/venv/Scripts/python.exe
VOXCPM_ASR_MODEL_DIR=D:/AI-Tools/VoxCPM/asr-models
VOXCPM_CACHE_DIR=D:/AI-Tools/VoxCPM/models
VOXCPM_MODEL_ID=openbmb/VoxCPM2
VOXCPM_DEVICE=cuda

DEV_USER_EMAIL=demo@stickmotion.local
DEV_USER_NAME=Demo Creator

# Jianying local draft installation root
JIANYING_DRAFTS_DIR=E:/剪映/JianyingPro Drafts
# Optional external user-provided sound-effect library.
SFX_LIBRARY_ROOT=E:\codex\素材库\音效
SUBTITLE_TEMPLATE_LIBRARY_ROOT=E:\codex\素材库\剪辑-剪映口播字幕模板合集
